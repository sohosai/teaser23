---
import type { CollectionEntry } from "astro:content";

type committeeDataType = CollectionEntry<"committee">["data"][number];
export type Props = {
  data: committeeDataType;
};

const { data } = Astro.props;
---

<div>
  <h3>{data.name}</h3>
  <p class="slogan">{data.slogan}</p>
  <p class="description">{data.description}</p>
</div>
<style lang="scss">
  div {
    margin-block: 1.5rem;
  }

  h3 {
    margin-block: 0.75em;
    font-size: 1.4em;
    font-weight: 600;
  }

  .slogan {
    position: relative;
    z-index: 0;
    display: inline-block;
    margin-block-end: 0.5em;
    font-size: 1.2rem;
    font-weight: normal;
    color: $font-black;
  }

  .slogan::after {
    position: absolute;
    bottom: 0.1em;
    left: 0;
    z-index: -1;
    width: 100%;
    height: 0.5em;
    content: "";
    background: $blue-translucent;
  }

  .description {
    white-space: pre-line;
  }
</style>
